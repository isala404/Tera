#!/bin/sh
set -eu

workspace=$(CDPATH= cd -- "${CODEX_HOME:-$PWD/.codex-home}/.." && pwd -P)
tera_bin=$(sed -n '/\[mcp_servers\.tera\]/,/^\[/p' "$workspace/.codex-home/config.toml" | awk -F '"' '/^[[:space:]]*command = / { print $2; exit }')

if [ -z "$tera_bin" ] || [ ! -x "$tera_bin" ]; then
    echo "Cannot find the Tera binary from $workspace/.codex-home/config.toml" >&2
    exit 1
fi

if [ "${1:-}" = "version" ]; then
    exec "$tera_bin" version
fi

exec "$tera_bin" update --workspace "$workspace" "$@"
