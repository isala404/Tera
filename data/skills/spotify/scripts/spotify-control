#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
SKILL_DIR="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
WORKSPACE="$(CDPATH= cd -- "$SKILL_DIR/../../.." && pwd)"
ROOT="${TERA_SPOTIFY_ROOT:-$WORKSPACE/.runtime/spotify-player}"
PLAYER="$ROOT/bin/spotify_player"

run_player() {
  "$PLAYER" --config-folder "$ROOT/config" --cache-folder "$ROOT/cache" "$@"
}

command_name="${1:-}"
shift || true
if [[ "$command_name" != "prereq" && "$command_name" != "auth" && ! -x "$PLAYER" ]]; then
  echo "Spotify helper is missing. Run scripts/spotify-prereq for the install command." >&2
  exit 1
fi

case "$command_name" in
  prereq)
    exec "$SCRIPT_DIR/spotify-prereq" "$@"
    ;;
  auth)
    exec "$SCRIPT_DIR/spotify-auth" start "$@"
    ;;
  status)
    run_player get key playback
    ;;
  devices)
    run_player get key devices
    ;;
  search)
    [[ $# -gt 0 ]] || { echo "Usage: spotify-control search QUERY" >&2; exit 2; }
    run_player search "$*"
    ;;
  track)
    [[ $# -gt 0 ]] || { echo "Usage: spotify-control track NAME" >&2; exit 2; }
    run_player playback start track --name "$*"
    ;;
  connect)
    [[ $# -gt 0 ]] || { echo "Usage: spotify-control connect DEVICE_NAME" >&2; exit 2; }
    run_player connect --name "$*"
    ;;
  play)
    run_player playback play
    ;;
  pause)
    run_player playback pause
    ;;
  toggle)
    run_player playback play-pause
    ;;
  next)
    run_player playback next
    ;;
  previous)
    run_player playback previous
    ;;
  open)
    uri="${1:-}"
    if [[ "$uri" =~ ^spotify:track:([[:alnum:]]+)$ ]]; then
      run_player playback start track --id "${BASH_REMATCH[1]}"
    elif [[ "$uri" =~ ^https://open\.spotify\.com/track/([[:alnum:]]+) ]]; then
      run_player playback start track --id "${BASH_REMATCH[1]}"
    else
      echo "Expected a Spotify track URI or track URL." >&2
      exit 2
    fi
    ;;
  *)
    echo "Usage: spotify-control {prereq|auth|status|devices|search|track|connect|play|pause|toggle|next|previous|open}" >&2
    exit 2
    ;;
esac
