#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
SKILL_DIR="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
WORKSPACE="$(CDPATH= cd -- "$SKILL_DIR/../../.." && pwd)"
ROOT="${TERA_SPOTIFY_ROOT:-$WORKSPACE/.runtime/spotify-player}"
PLAYER="$ROOT/bin/spotify_player"
CONFIG="$ROOT/config/app.toml"
CACHE="$ROOT/cache"
LOG="$CACHE/tera-authenticate.log"
RELAY_LOG="$CACHE/tera-auth-relay.log"

mkdir -p "$ROOT/config" "$CACHE"
if [[ ! -f "$CONFIG" ]]; then
  cp "$SKILL_DIR/config/app.toml" "$CONFIG"
fi
if [[ ! -x "$PLAYER" ]]; then
  echo "Spotify helper is missing. Run:"
  echo "cargo install spotify_player --locked --root '$ROOT'"
  exit 1
fi

case "${1:-start}" in
  start)
    if ! python3 - "$ROOT" <<'PY'
import socket
with socket.create_connection(("127.0.0.1", 8790), timeout=0.3):
    pass
PY
    then
      nohup python3 "$SCRIPT_DIR/spotify-auth-relay.py" >>"$RELAY_LOG" 2>&1 </dev/null &
    fi

    nohup "$PLAYER" --config-folder "$ROOT/config" --cache-folder "$ROOT/cache" authenticate \
      >>"$LOG" 2>&1 </dev/null &

    url=""
    for _ in $(seq 1 20); do
      url="$(grep -Eo 'https://accounts\.spotify\.com/authorize[^[:space:]]+' "$LOG" | tail -1 || true)"
      [[ -n "$url" ]] && break
      sleep 0.25
    done

    if [[ -n "$url" ]]; then
      echo "Open this Spotify PKCE URL on the phone:"
      echo "$url"
    else
      echo "Spotify authentication started, but its URL was not printed yet."
      echo "Inspect $LOG locally or run this command again."
    fi
    echo "After approval, use the relay page at http://<pi-address>:8790."
    echo "Do not send the redirected callback or its code through WhatsApp."
    ;;
  *)
    echo "Usage: spotify-auth start" >&2
    exit 2
    ;;
esac
