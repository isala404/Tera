#!/usr/bin/env python3
"""Local speech recognition and synthesis for Tera using Aloud Q8 models."""

import argparse
import hashlib
import os
import platform
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.error
import urllib.request
from pathlib import Path

ALOUD_VERSION = "0.1.0"
RELEASE_URL = f"https://github.com/isala404/aloud/releases/download/v{ALOUD_VERSION}"
ASR_MODEL = "hf://isala404/aloud/audio8-asr-0.1b-q8_0.gguf"
TTS_MODEL = "hf://isala404/aloud/audio8-tts-0.6b-q8_0.gguf"
DOWNLOAD_TIMEOUT_SECONDS = 60

RELEASES = {
    ("Darwin", "arm64"): (
        f"aloud-{ALOUD_VERSION}-aarch64-apple-darwin.tar.gz",
        "f44672cc7b7888dd17b16de8733e3d7c7076ce7b3f0bc6e7b9787171d206d4ea",
    ),
    ("Linux", "aarch64"): (
        f"aloud-{ALOUD_VERSION}-aarch64-unknown-linux-gnu.tar.gz",
        "fdee78e7b576af67cfec2aa6931b63729b4751bdafac3dc1f9db44c5ac509a25",
    ),
    ("Linux", "x86_64"): (
        f"aloud-{ALOUD_VERSION}-x86_64-unknown-linux-gnu.tar.gz",
        "35043c30fdf464260065c4b6746b23f09eec79efdf9605c7e099b681f7fd50c6",
    ),
}


class AudioError(Exception):
    pass


def workspace_root():
    return Path(__file__).resolve().parents[4]


def runtime_root():
    configured = os.environ.get("TERA_ALOUD_ROOT")
    return Path(configured) if configured else workspace_root() / ".runtime" / "aloud"


def cli_path():
    return runtime_root() / "aloud"


def ffmpeg_binary():
    found = shutil.which("ffmpeg")
    if not found:
        raise AudioError("ffmpeg is not on PATH")
    return found


def platform_release():
    key = (platform.system(), platform.machine())
    if key not in RELEASES:
        supported = ", ".join(f"{system} {machine}" for system, machine in sorted(RELEASES))
        raise AudioError(f"No Aloud release for {key[0]} {key[1]}. Supported: {supported}.")
    return RELEASES[key]


def download(url, destination, expected_sha256):
    destination.parent.mkdir(parents=True, exist_ok=True)
    partial = destination.with_name(f".{destination.name}.part")
    digest = hashlib.sha256()
    try:
        request = urllib.request.Request(url, headers={"User-Agent": "tera-audio-skill"})
        with urllib.request.urlopen(request, timeout=DOWNLOAD_TIMEOUT_SECONDS) as response:
            with partial.open("wb") as handle:
                while block := response.read(1 << 20):
                    digest.update(block)
                    handle.write(block)
    except (urllib.error.URLError, OSError) as error:
        partial.unlink(missing_ok=True)
        raise AudioError(f"Cannot download {url}: {error}") from error

    if digest.hexdigest() != expected_sha256:
        partial.unlink(missing_ok=True)
        raise AudioError(f"{url} does not match its pinned checksum")
    partial.replace(destination)


def install_cli():
    archive_name, expected_sha256 = platform_release()
    with tempfile.TemporaryDirectory() as scratch_name:
        archive = Path(scratch_name) / archive_name
        download(f"{RELEASE_URL}/{archive_name}", archive, expected_sha256)
        with tarfile.open(archive) as bundle:
            member = next((entry for entry in bundle if Path(entry.name).name == "aloud"), None)
            if member is None:
                raise AudioError(f"{archive_name} contains no aloud binary")
            source = bundle.extractfile(member)
            if source is None:
                raise AudioError(f"aloud in {archive_name} is not a regular file")
            destination = cli_path()
            destination.parent.mkdir(parents=True, exist_ok=True)
            partial = destination.with_name(".aloud.part")
            with partial.open("wb") as handle:
                shutil.copyfileobj(source, handle)
            partial.chmod(0o755)
            partial.replace(destination)


def setup():
    ffmpeg_binary()
    if cli_path().is_file():
        print(f"aloud {ALOUD_VERSION} is already installed")
        return
    print(f"Installing aloud {ALOUD_VERSION}")
    install_cli()
    print(f"Installed {cli_path()}")


def status():
    print(f"aloud: {'installed' if cli_path().is_file() else 'missing'}")
    print(f"ffmpeg: {'found' if shutil.which('ffmpeg') else 'missing'}")
    print(f"asr: {ASR_MODEL}")
    print(f"tts: {TTS_MODEL}")
    print(f"root: {runtime_root()}")


def require_cli():
    if not cli_path().is_file():
        raise AudioError("Aloud is not installed yet. Run `scripts/transcribe setup` first")


def run(command, action):
    finished = subprocess.run(command, capture_output=True, text=True)
    if finished.returncode != 0:
        detail = finished.stderr.strip().splitlines()
        tail = "\n".join(detail[-8:]) if detail else "no output"
        raise AudioError(f"{action} failed:\n{tail}")
    return finished.stdout.strip()


def decode(source, destination, sample_rate):
    run(
        [
            ffmpeg_binary(), "-v", "error", "-y", "-i", str(source), "-vn",
            "-ac", "1", "-ar", str(sample_rate), "-c:a", "pcm_s16le", str(destination),
        ],
        "audio conversion",
    )


def transcribe(source):
    require_cli()
    source = Path(source).expanduser()
    if not source.is_file():
        raise AudioError(f"{source} is not a file")
    with tempfile.TemporaryDirectory() as scratch_name:
        wav = Path(scratch_name) / "input.wav"
        decode(source, wav, 16000)
        return run(
            [str(cli_path()), "transcribe", str(wav), "--model", ASR_MODEL, "--device", "cpu"],
            "transcription",
        )


def synthesize(text, output, voice, voice_note):
    require_cli()
    output = Path(output).expanduser()
    output.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory() as scratch_name:
        wav = Path(scratch_name) / "speech.wav" if voice_note else output
        run(
            [
                str(cli_path()), "tts", text, "-o", str(wav), "--model", TTS_MODEL,
                "--voice", voice, "--device", "cpu",
            ],
            "speech synthesis",
        )
        if voice_note:
            run(
                [
                    ffmpeg_binary(), "-v", "error", "-y", "-i", str(wav),
                    "-ac", "1", "-c:a", "libopus", "-b:a", "32k", "-application", "voip",
                    str(output),
                ],
                "voice-note encoding",
            )
    return output


def parser():
    root = argparse.ArgumentParser(prog="transcribe")
    commands = root.add_subparsers(dest="command", required=True)
    commands.add_parser("setup")
    commands.add_parser("status")
    transcribe_parser = commands.add_parser("run")
    transcribe_parser.add_argument("file")
    tts_parser = commands.add_parser("tts")
    tts_parser.add_argument("text")
    tts_parser.add_argument("-o", "--output", required=True)
    tts_parser.add_argument("--voice", choices=("sky", "aiden"), default="sky")
    tts_parser.add_argument("--voice-note", action="store_true")
    return root


def main():
    argv = sys.argv[1:]
    if argv and argv[0] not in ("setup", "status", "run", "tts", "-h", "--help"):
        argv = ["run", *argv]
    args = parser().parse_args(argv)
    if args.command == "setup":
        setup()
    elif args.command == "status":
        status()
    elif args.command == "tts":
        print(synthesize(args.text, args.output, args.voice, args.voice_note))
    else:
        print(transcribe(args.file))


if __name__ == "__main__":
    try:
        main()
    except AudioError as error:
        print(f"audio: {error}", file=sys.stderr)
        raise SystemExit(1)
